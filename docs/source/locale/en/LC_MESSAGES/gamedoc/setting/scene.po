#: ../../source/gamedoc/setting/scene.md:3
msgid "一、军事学院（游戏世界）"
msgstr "1. Military Academy (Game World)"

#: ../../source/gamedoc/setting/scene.md:5
#: ../../source/gamedoc/setting/scene.md:143
