#: ../../source/gamedoc/characters/moling.md:6
msgid "默翎（英文名：Lian 丽安）"
msgstr "Mo Ling (English name: Lian)"

#: ../../source/gamedoc/characters/moling.md:6
msgid "年龄"
msgstr "Age"

#: ../../source/gamedoc/characters/moling.md:6
msgid "24岁"
msgstr "24 years old"

