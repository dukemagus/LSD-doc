#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "别动..（伴随火焰响声，我被火焰包围）"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "出现文字：（玩家名）已上线79.03.27.09.24"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "你是谁？"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "出现文字：代理日志更新，代理第1天；"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "你为什么在这里？"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
msgid "出现文字：接受任务，保护你第一个见到的人"
msgstr ""

#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:3
#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:43
#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:65
#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:111
#: ../../source/gamedoc/story-scripting/game0/dialogue-script.md:149
