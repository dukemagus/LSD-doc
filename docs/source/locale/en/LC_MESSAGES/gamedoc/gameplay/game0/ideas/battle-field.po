#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:1
msgid "战场玩法"
msgstr "Battlefield Gameplay"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:3
msgid "作者"
msgstr "Author"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:4
msgid "&emsp;&emsp;建建"
msgstr "&emsp;&emsp;Jianjian"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:7
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:58
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:81
msgid "⽬标"
msgstr "Objectives"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:9
msgid "&emsp;&emsp;设计⼀个主要玩法，满⾜这些要求"
msgstr "&emsp;&emsp;Design a primary gameplay mode that meets these requirements"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:10
msgid "关键词：⾼重玩性、⾼随机性、多⻆⾊、策略搭配、探索"
msgstr "Keywords: High replayability, High randomness, Multiple characters, Strategic combinations, Exploration"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:11
msgid "紧张刺激，有明确的胜利失败⽬标"
msgstr "Intense and exciting, with clear victory and defeat conditions"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:12
msgid "可重玩性和随机性⾼ 持续时间约3分钟-10分钟"
msgstr "High replayability and randomness. Duration approximately 3-10 minutes"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:13
msgid "相对独⽴（这⼀场战⽃和上⼀场战⽃的结果没多⼤关系）"
msgstr "Relatively independent (the outcome of one battle has little relation to the previous battle)"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:14
msgid "玩点"
msgstr "Gameplay Highlights"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:15
msgid "⽐较丰富的战前策略和配置（玩家携带1-N个⻆⾊参与）"
msgstr "Rich pre-battle strategy and configuration (players bring 1-N characters to participate)"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:16
msgid "战⽃中的策略和选择"
msgstr "In-battle strategy and choices"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:17
msgid "有部分玩点和时间相关"
msgstr "Some gameplay elements are time-related"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:18
msgid "与AI紧密结合"
msgstr "Closely integrated with AI"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:19
msgid "玩家将根据⻆⾊AI来预测战⽃结果，⽽这个结果很重要"
msgstr "Players will predict battle outcomes based on character AI, and this result is important"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:21
msgid "⽅案1"
msgstr "Plan 1"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:23
msgid "核⼼可分配资源：⻆⾊、路径"
msgstr "Core Allocatable Resources: Characters, Paths"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:24
msgid "⼀个简单的分配资源求最⼤值的玩法+路径规划玩法"
msgstr "A simple resource allocation maximization gameplay + path planning gameplay"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:26
msgid "玩法⽰意图"
msgstr "Gameplay Diagram"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:28
msgid "玩家消耗能量上场⻆⾊、升级⻆⾊、激活技能"
msgstr "Players spend energy to deploy characters, upgrade characters, and activate skills"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:29
msgid "⻆⾊战⽃占领房间，获得buff（可以增加战⽃⼒，但是会消耗能量）"
msgstr "Characters fight to occupy rooms and gain buffs (which increase combat power but consume energy)"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:30
msgid "玩家要合理的花费能量，获得相对较多的buff，并且保留⾜够的能量给boss战。"
msgstr "Players must spend energy wisely to gain relatively more buffs while retaining enough energy for the boss fight."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:33
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:37
msgid "能量管理的机制"
msgstr "Energy Management Mechanism"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:40
msgid "战⽃胜利后选择通往的房间"
msgstr "After battle victory, choose the room to advance to"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:41
msgid "需要考虑⽤尽可能少的战⽃次数，获得最多的buff，并且到达boss处"
msgstr "Consider achieving the most buffs with the fewest battles while reaching the boss"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:44
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:48
msgid "关卡流程示意"
msgstr "Level Flow Diagram"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:51
msgid "思路"
msgstr "Concept"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:53
msgid "玩家选择"
msgstr "Player Choices"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:54
msgid "选择上场⻆⾊，M选N"
msgstr "Select characters to deploy, choose N from M"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:55
msgid "放置⻆⾊到不同战场、位置，M选N"
msgstr "Place characters in different battlefields and positions, choose N from M"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:56
msgid "设定进攻⽬标，M选1"
msgstr "Set attack target, choose 1 from M"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:57
msgid "释放⻆⾊技能（如⼤招），切换状态（如全员加速）"
msgstr "Release character skills (e.g. ultimate), switch states (e.g. accelerate all units)"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:59
msgid "终极⽬标：成功击败boss"
msgstr "Ultimate Objective: Successfully defeat the boss"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:60
msgid "玩家资源⽬标：能量，战⽃⼒"
msgstr "Player Resource Objectives: Energy, Combat Power"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:61
msgid "中间性⽬标：击败敌军先后顺序，占领特定房间"
msgstr "Intermediate Objectives: Order of defeating enemy forces, occupying specific rooms"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:62
msgid "⽬标连接"
msgstr "Objective Connections"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:63
msgid "击败Boss ← 战⽃⼒ ← 战⽃buff ← 占领特定房间 ← 通往特定房间 ← 战⽃ ← 能量"
msgstr "Defeat Boss ← Combat Power ← Battle Buffs ← Occupy Specific Rooms ← Path to Specific Rooms ← Battle ← Energy"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:64
msgid "击败Boss ← 能量（有能量才能上场⻆⾊和放技能）"
msgstr "Defeat Boss ← Energy (energy is needed to deploy characters and use skills)"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:65
msgid "能量 ← 占领特定房间 ← 通往特定房间 ← 战⽃ ← 能量"
msgstr "Energy ← Occupy Specific Rooms ← Path to Specific Rooms ← Battle ← Energy"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:67
msgid "规则"
msgstr "Rules"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:69
msgid "操作"
msgstr "Operations"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:70
msgid "可以拖动⻆⾊上场战⽃，需要消耗能量。"
msgstr "Characters can be dragged onto the battlefield, which consumes energy."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:71
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:78
msgid "当⼀个房间中的敌⼈全部被杀死后，玩家可以点击该房间连通的任意房间，⻆⾊即前往该房间。"
msgstr "When all enemies in a room are killed, the player can click any connected room and the characters will move there."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:72
msgid "元素"
msgstr "Elements"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:73
#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:88
msgid "⻆⾊"
msgstr "Characters"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:74
msgid "战⽃开始后玩家可以拖动⻆⾊上场战⽃，需要消耗能量。"
msgstr "After battle starts, players can drag characters onto the battlefield, which consumes energy."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:75
msgid "⻆⾊死亡进⼊受伤状态，⼀段时间后⾃动恢复到正常状态，可以花费能量再次上场。"
msgstr "When a character dies, they enter an injured state. After a period of time, they automatically recover to normal state and can be redeployed by spending energy."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:76
msgid "房间"
msgstr "Rooms"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:77
msgid "每个房间是⼀个独⽴的战场"
msgstr "Each room is an independent battlefield"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:79
msgid "buff"
msgstr "Buff"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:80
msgid "杀死某些房间的敌⼈后可以获得特定buff，增强战⽃⼒。"
msgstr "Killing enemies in certain rooms grants specific buffs that enhance combat power."

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:82
msgid "胜利⽬标：战胜boss"
msgstr "Victory Condition: Defeat the boss"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:83
msgid "失败条件：场上所有⻆⾊死亡，并且没有能量再次上场⻆⾊"
msgstr "Defeat Condition: All characters on the field are dead and there is no energy to redeploy characters"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:85
msgid "随机性"
msgstr "Randomness"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:87
msgid "房间、地图"
msgstr "Rooms, Maps"

#: ../../source/gamedoc/gameplay/game0/ideas/battle-field.md:89
msgid "战⽃掉落"
msgstr "Battle Drops"
